# ==========================================
# CardioVista Environment Configuration
# ==========================================

# --- Backend Configuration ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Local SQLite file for prediction history (git-ignored)
DATABASE_PATH=backend/data/cardiovista.db
`n# Model Artifacts & Data Paths
MODEL_ARTIFACTS_DIR=backend/model_artifacts
DATASET_PATH=docs/extention of Z-Alizadeh sani dataset.xlsx

# Explainability & SHAP
ENABLE_SHAP_EXPLANATIONS=True
SHAP_MAX_DISPLAY_FEATURES=10

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=CardioVista - 3D CAD Risk Visualization
VITE_3D_MODEL_PATH=/models/heart-scan.glb
